execute if score @s btki.difficulty matches 0 run function coffeelipe.btki:utils/difficulty/set_peaceful
execute if score @s btki.difficulty matches 1 run function coffeelipe.btki:utils/difficulty/set_easy
execute if score @s btki.difficulty matches 2 run function coffeelipe.btki:utils/difficulty/set_normal
execute if score @s btki.difficulty matches 3 run function coffeelipe.btki:utils/difficulty/set_hard